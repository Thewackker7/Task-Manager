# Copy to .env and adjust. Never commit the real .env file.

# --- Used by docker-compose for the database container ---
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=taskpass
POSTGRES_DB=taskdb

# --- Used when running the API directly on your machine (without Docker) ---
DATABASE_URL=postgresql+psycopg://taskuser:taskpass@localhost:5432/taskdb
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# --- Authentication ---
# REQUIRED. At least 32 characters. Generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Anyone who knows this value can forge login tokens, so keep it private.
SECRET_KEY=change-me-generate-a-real-secret-with-the-command-above
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Tests ---
# Tests use a SEPARATE database (name must end in _test). It is created automatically.
TEST_DATABASE_URL=postgresql+psycopg://taskuser:taskpass@localhost:5432/taskdb_test
